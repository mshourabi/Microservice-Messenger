logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "messenger" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "messenger_logs" {
  targets = discovery.docker.messenger.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "messenger" {
  host = "unix:///var/run/docker.sock"

  targets = discovery.docker.messenger.targets

  labels = {
    environment = "development",
  }

  relabel_rules = discovery.relabel.messenger_logs.rules

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}